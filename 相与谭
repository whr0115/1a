<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <title>谭与相</title>
                <style>
                        * {
                                        margin: 0;
                                                    padding: 0;
                                                                box-sizing: border-box;
                        }

                                body {
                                                font-family: 'Microsoft YaHei', sans-serif;
                                                            background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 50%, #fecfef 100%);
                                                                        min-height: 100vh;
                                                                                    position: relative;
                                                                                                overflow-x: hidden;
                                }

                                        /* 背景装饰元素 */
                                                .background-elements {
                                                                position: fixed;
                                                                            top: 0;
                                                                                        left: 0;
                                                                                                    width: 100%;
                                                                                                                height: 100%;
                                                                                                                            pointer-events: none;
                                                                                                                                        z-index: 1;
                                                }

                                                        /* 爱心装饰 */
                                                                .heart {
                                                                                position: absolute;
                                                                                            color: rgba(255, 182, 193, 0.6);
                                                                                                        font-size: 20px;
                                                                                                                    animation: float 6s ease-in-out infinite;
                                                                }

                                                                        .heart:nth-child(1) { top: 10%; left: 10%; animation-delay: 0s; }
                                                                                .heart:nth-child(2) { top: 20%; right: 15%; animation-delay: 1s; }
                                                                                        .heart:nth-child(3) { top: 60%; left: 5%; animation-delay: 2s; }
                                                                                                .heart:nth-child(4) { top: 70%; right: 10%; animation-delay: 3s; }
                                                                                                        .heart:nth-child(5) { top: 40%; left: 80%; animation-delay: 4s; }
                                                                                                                .heart:nth-child(6) { top: 80%; left: 20%; animation-delay: 5s; }

                                                                                                                        /* 玫瑰花装饰 */
                                                                                                                                .rose {
                                                                                                                                                position: absolute;
                                                                                                                                                            font-size: 24px;
                                                                                                                                                                        color: rgba(221, 160, 221, 0.7);
                                                                                                                                                                                    animation: rotate 8s linear infinite;
                                                                                                                                }

                                                                                                                                        .rose:nth-child(7) { top: 15%; left: 70%; animation-delay: 0s; }
                                                                                                                                                .rose:nth-child(8) { top: 35%; right: 5%; animation-delay: 2s; }
                                                                                                                                                        .rose:nth-child(9) { top: 55%; right: 60%; animation-delay: 4s; }
                                                                                                                                                                .rose:nth-child(10) { top: 75%; left: 65%; animation-delay: 6s; }

                                                                                                                                                                        @keyframes float {
                                                                                                                                                                                        0%, 100% { transform: translateY(0px) rotate(0deg); opacity: 0.6; }
                                                                                                                                                                                                    50% { transform: translateY(-20px) rotate(10deg); opacity: 0.9; }
                                                                                                                                                                        }

                                                                                                                                                                                @keyframes rotate {
                                                                                                                                                                                                0% { transform: rotate(0deg); }
                                                                                                                                                                                                            100% { transform: rotate(360deg); }
                                                                                                                                                                                }

                                                                                                                                                                                        /* 主容器 */
                                                                                                                                                                                                .container {
                                                                                                                                                                                                                position: relative;
                                                                                                                                                                                                                            z-index: 2;
                                                                                                                                                                                                                                        display: flex;
                                                                                                                                                                                                                                                    flex-direction: column;
                                                                                                                                                                                                                                                                align-items: center;
                                                                                                                                                                                                                                                                            justify-content: center;
                                                                                                                                                                                                                                                                                        min-height: 100vh;
                                                                                                                                                                                                                                                                                                    padding: 20px;
                                                                                                                                                                                                                                                                                                                text-align: center;
                                                                                                                                                                                                }

                                                                                                                                                                                                        /* 标题样式 */
                                                                                                                                                                                                                .title {
                                                                                                                                                                                                                                font-size: 4rem;
                                                                                                                                                                                                                                            color: #d63384;
                                                                                                                                                                                                                                                        margin-bottom: 30px;
                                                                                                                                                                                                                                                                    text-shadow: 2px 2px 4px rgba(0,0,0,0.1);
                                                                                                                                                                                                                                                                                font-weight: bold;
                                                                                                                                                                                                                                                                                            background: linear-gradient(45deg, #d63384, #e91e63, #f06292);
                                                                                                                                                                                                                                                                                                        -webkit-background-clip: text;
                                                                                                                                                                                                                                                                                                                    -webkit-text-fill-color: transparent;
                                                                                                                                                                                                                                                                                                                                background-clip: text;
                                                                                                                                                                                                                                                                                                                                            animation: titleGlow 3s ease-in-out infinite alternate;
                                                                                                                                                                                                                }

                                                                                                                                                                                                                        @keyframes titleGlow {
                                                                                                                                                                                                                                        from { filter: drop-shadow(0 0 10px rgba(214, 51, 132, 0.3)); }
                                                                                                                                                                                                                                                    to { filter: drop-shadow(0 0 20px rgba(233, 30, 99, 0.6)); }
                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                /* 时间显示区域 */
                                                                                                                                                                                                                                        .time-container {
                                                                                                                                                                                                                                                        background: rgba(255, 255, 255, 0.9);
                                                                                                                                                                                                                                                                    backdrop-filter: blur(10px);
                                                                                                                                                                                                                                                                                border-radius: 20px;
                                                                                                                                                                                                                                                                                            padding: 40px;
                                                                                                                                                                                                                                                                                                        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
                                                                                                                                                                                                                                                                                                                    border: 1px solid rgba(255, 255, 255, 0.2);
                                                                                                                                                                                                                                                                                                                                margin: 20px;
                                                                                                                                                                                                                                                                                                                                            min-width: 400px;
                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                .time-label {
                                                                                                                                                                                                                                                                font-size: 1.5rem;
                                                                                                                                                                                                                                                                            color: #d63384;
                                                                                                                                                                                                                                                                                        margin-bottom: 20px;
                                                                                                                                                                                                                                                                                                    font-weight: bold;
                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                        .time-display {
                                                                                                                                                                                                                                                                        font-size: 2.5rem;
                                                                                                                                                                                                                                                                                    color: #333;
                                                                                                                                                                                                                                                                                                font-weight: bold;
                                                                                                                                                                                                                                                                                                            font-family: 'Courier New', monospace;
                                                                                                                                                                                                                                                                                                                        margin-bottom: 10px;
                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                .start-date {
                                                                                                                                                                                                                                                                                font-size: 1rem;
                                                                                                                                                                                                                                                                                            color: #666;
                                                                                                                                                                                                                                                                                                        margin-top: 15px;
                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                        /* 响应式设计 */
                                                                                                                                                                                                                                                                                @media (max-width: 768px) {
                                                                                                                                                                                                                                                                                                .title {
                                                                                                                                                                                                                                                                                                                    font-size: 2.5rem;
                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                                        .time-container {
                                                                                                                                                                                                                                                                                                                                            min-width: 300px;
                                                                                                                                                                                                                                                                                                                                                            padding: 30px 20px;
                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                                                                                .time-display {
                                                                                                                                                                                                                                                                                                                                                                    font-size: 2rem;
                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                        @media (max-width: 480px) {
                                                                                                                                                                                                                                                                                                        .title {
                                                                                                                                                                                                                                                                                                                            font-size: 2rem;
                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                                                                .time-container {
                                                                                                                                                                                                                                                                                                                                                    min-width: 280px;
                                                                                                                                                                                                                                                                                                                                                                    padding: 25px 15px;
                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                                                                        .time-display {
                                                                                                                                                                                                                                                                                                                                                                            font-size: 1.8rem;
                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                            </style>
                                                                                                                                                                                                                                                                                            </head>
                                                                                                                                                                                                                                                                                            <body>
                                                                                                                                                                                                                                                                                                <!-- 背景装饰元素 -->
                                                                                                                                                                                                                                                                                                    <div class="background-elements">
                                                                                                                                                                                                                                                                                                            <div class="heart">♥</div>
                                                                                                                                                                                                                                                                                                                    <div class="heart">♥</div>
                                                                                                                                                                                                                                                                                                                            <div class="heart">♥</div>
                                                                                                                                                                                                                                                                                                                                    <div class="heart">♥</div>
                                                                                                                                                                                                                                                                                                                                            <div class="heart">♥</div>
                                                                                                                                                                                                                                                                                                                                                    <div class="heart">♥</div>
                                                                                                                                                                                                                                                                                                                                                            <div class="rose">🌹</div>
                                                                                                                                                                                                                                                                                                                                                                    <div class="rose">🌹</div>
                                                                                                                                                                                                                                                                                                                                                                            <div class="rose">🌹</div>
                                                                                                                                                                                                                                                                                                                                                                                    <div class="rose">🌹</div>
                                                                                                                                                                                                                                                                                                                                                                                        </div>

                                                                                                                                                                                                                                                                                                                                                                                            <!-- 主内容 -->
                                                                                                                                                                                                                                                                                                                                                                                                <div class="container">
                                                                                                                                                                                                                                                                                                                                                                                                        <h1 class="title">谭与相</h1>
                                                                                                                                                                                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                                                                                                                                                        <div class="time-container">
                                                                                                                                                                                                                                                                                                                                                                                                                                    <div class="time-label">💕 我们的美好时光 💕</div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                <div class="time-display" id="timeDisplay">计算中...</div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                            <div class="start-date">起始日期：2024年2月15日</div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        </div>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <script>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    // 设置起始日期：2024年2月15日
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            const startDate = new Date('2024-02-15T00:00:00');
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            function updateTime() {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            const now = new Date();
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        const timeDiff = now - startDate;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                // 计算天数（正数）
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            const days = Math.floor(timeDiff / (1000 * 60 * 60 * 24));
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    // 计算其他时间单位
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                const hours = Math.floor((timeDiff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            const minutes = Math.floor((timeDiff % (1000 * 60 * 60)) / (1000 * 60));
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        const seconds = Math.floor((timeDiff % (1000 * 60)) / 1000);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                // 更新显示
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if (days > 0) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                document.getElementById('timeDisplay').innerHTML = 
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    `❤️ 相伴 <span style="color: #d63384;">${days}</span> 天 ❤️<br>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         ⏰ ${hours}小时 ${minutes}分钟 ${seconds}秒`;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            } else {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                document.getElementById('timeDisplay').innerHTML = 
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    `🌱 即将开始我们的故事...<br>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         ⏰ ${hours}小时 ${minutes}分钟 ${seconds}秒`;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            // 页面加载时立即更新一次
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    updateTime();
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    // 每秒更新时间
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            setInterval(updateTime, 1000);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                </script>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                </body>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                </html>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                        }
                                                                                                                                                                                                                }
                                                                                                                                                                                                }
                                                                                                                                                                                }
                                                                                                                                                                        }
                                                                                                                                }
                                                                }
                                                }
                                }
                        }